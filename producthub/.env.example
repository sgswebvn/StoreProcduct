# ============================================================
# StoreProduct — Environment Variables Example
# Copy file này thành .env.local và điền các giá trị thực tế
# TUYỆT ĐỐI KHÔNG commit .env.local vào Git
# ============================================================

# --- Cơ sở dữ liệu MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=

# --- NextAuth v5 Xác Thực Phiên ---
AUTH_SECRET=
NEXTAUTH_URL=

# --- Cấu hình Ứng dụng & Thương hiệu ---
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=

# --- Lưu trữ Ảnh qua Google Drive API (OAuth 2.0) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Khởi tạo tài khoản Owner lần đầu (Chỉ dùng khi chạy script seed) ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
